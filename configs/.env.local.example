# Local Development Overrides
# Copy this file to .env.local for local-specific configuration

# Local PostgreSQL connection (override for local development)
# POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/events_local?sslmode=disable

# Local Kafka (if running locally)
# KAFKA_ENABLED=true
# KAFKA_BROKERS=localhost:9092

# Development-specific settings
# SERVER_PORT=8080

# Enable verbose logging for local debugging
# LOG_LEVEL=debug
