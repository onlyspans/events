# Event Logs Service Configuration
# Copy this file to .env and update with your actual values

# ==============================================================================
# HTTP Server Configuration
# ==============================================================================

# Port for the HTTP API server
SERVER_PORT=8080

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================

# PostgreSQL host (use 'localhost' for local development, 'postgres' in Docker)
POSTGRES_HOST=localhost

# PostgreSQL port
POSTGRES_PORT=5432

# PostgreSQL database name
POSTGRES_DB=events

# PostgreSQL username
POSTGRES_USER=events

# PostgreSQL password (CHANGE THIS IN PRODUCTION!)
POSTGRES_PASSWORD=events

# PostgreSQL SSL mode (disable, require, verify-ca, verify-full)
# Use 'disable' for local development, 'require' or higher in production
POSTGRES_SSLMODE=disable

# ==============================================================================
# Kafka Configuration
# ==============================================================================

# Kafka broker host (use 'localhost' for local development, 'kafka' in Docker)
KAFKA_HOST=localhost

# Kafka broker port
KAFKA_PORT=9092

# Kafka topic to consume events from
KAFKA_TOPIC=event-logs

# Kafka consumer group ID
KAFKA_GROUP_ID=event-logs-group

# Kafka SASL authentication (leave empty if not using authentication)
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Kafka consumer polling configuration
# Maximum number of records to poll in a single request
KAFKA_MAX_POLL_RECORDS=100

# Minimum bytes to fetch per poll request
KAFKA_FETCH_MIN_BYTES=1

# Maximum time to wait for fetch in milliseconds
KAFKA_FETCH_MAX_WAIT_MS=500

# Session timeout in milliseconds (30 seconds)
KAFKA_SESSION_TIMEOUT_MS=30000

# Heartbeat interval in milliseconds (10 seconds)
KAFKA_HEARTBEAT_INTERVAL_MS=10000

# ==============================================================================
# Event Log Specific Configuration
# ==============================================================================

# Retention period for events in days (events older than this will be deleted)
RETENTION_PERIOD_DAYS=90

# Maximum number of events to export in a single CSV export
MAX_EXPORT_SIZE=10000

# Cron schedule for retention job (default: daily at 2 AM UTC)
# Format: minute hour day month weekday
# Examples:
#   0 2 * * *     - Daily at 2 AM
#   0 */6 * * *   - Every 6 hours
#   0 0 * * 0     - Weekly on Sunday at midnight
RETENTION_CRON=0 2 * * *
