# Event Logs Service - Minimal Configuration
# Copy this file to .env and update POSTGRES_PASSWORD

# ==============================================================================
# Required Configuration
# ==============================================================================

# PostgreSQL password (REQUIRED - no default for security)
POSTGRES_PASSWORD=your-secure-password-here

# ==============================================================================
# Optional Configuration (sensible defaults provided)
# ==============================================================================

# Database Connection (defaults work for Docker Compose)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_DB=events
# POSTGRES_SSLMODE=disable

# Server Configuration
# SERVER_PORT=8080

# Feature Flags
# KAFKA_ENABLED=false     # Set to 'true' to enable Kafka consumer
# AUTO_MIGRATE=true       # Set to 'false' to disable automatic migrations

# Event Retention & Export
# RETENTION_PERIOD_DAYS=90
# MAX_EXPORT_SIZE=10000
# RETENTION_CRON=0 2 * * *

# ==============================================================================
# Kafka Configuration (only used when KAFKA_ENABLED=true)
# ==============================================================================

# Kafka Connection
# KAFKA_HOST=localhost
# KAFKA_PORT=9092
# KAFKA_TOPIC=event-logs
# KAFKA_GROUP_ID=event-logs-group

# Kafka SASL Authentication (optional)
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

# Kafka Consumer Tuning (advanced)
# KAFKA_MAX_POLL_RECORDS=100
# KAFKA_FETCH_MIN_BYTES=1
# KAFKA_FETCH_MAX_WAIT_MS=500
# KAFKA_SESSION_TIMEOUT_MS=30000
# KAFKA_HEARTBEAT_INTERVAL_MS=10000
