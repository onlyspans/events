# Event Logs Service - Kafka-Enabled Configuration
# Copy this file to .env and update required values
# This example shows configuration for deployments with Kafka consumer enabled

# ==============================================================================
# Required Configuration
# ==============================================================================

# PostgreSQL password (REQUIRED - no default for security)
POSTGRES_PASSWORD=your-secure-password-here

# ==============================================================================
# Feature Flags (Kafka Mode)
# ==============================================================================

# Enable Kafka consumer (set to 'true' for this deployment mode)
KAFKA_ENABLED=true

# Auto-migrate database on startup (recommended)
# AUTO_MIGRATE=true

# ==============================================================================
# Kafka Connection (required when KAFKA_ENABLED=true)
# ==============================================================================

# Kafka broker address
KAFKA_HOST=localhost
KAFKA_PORT=9092

# Kafka topic and consumer group
KAFKA_TOPIC=event-logs
KAFKA_GROUP_ID=event-logs-group

# ==============================================================================
# Kafka SASL Authentication (optional, for production environments)
# ==============================================================================

# Uncomment and configure for SASL/SCRAM-SHA-512 authentication
# KAFKA_USERNAME=your-kafka-username
# KAFKA_PASSWORD=your-kafka-password

# ==============================================================================
# Optional Configuration (sensible defaults provided)
# ==============================================================================

# Database Connection (defaults work for Docker Compose)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_DB=events
# POSTGRES_SSLMODE=disable

# Server Configuration
# SERVER_PORT=8080

# Event Retention & Export
# RETENTION_PERIOD_DAYS=90
# MAX_EXPORT_SIZE=10000
# RETENTION_CRON=0 2 * * *

# ==============================================================================
# Kafka Consumer Tuning (advanced, only modify if needed)
# ==============================================================================

# Maximum records to fetch in one poll
# KAFKA_MAX_POLL_RECORDS=100

# Minimum bytes to fetch (1 = fetch immediately)
# KAFKA_FETCH_MIN_BYTES=1

# Maximum wait time for fetch request (ms)
# KAFKA_FETCH_MAX_WAIT_MS=500

# Session timeout (ms) - consumer is considered dead if no heartbeat
# KAFKA_SESSION_TIMEOUT_MS=30000

# Heartbeat interval (ms) - must be < session timeout
# KAFKA_HEARTBEAT_INTERVAL_MS=10000
